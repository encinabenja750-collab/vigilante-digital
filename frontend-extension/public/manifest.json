{
  "manifest_version": 3,
  "name": "Vigilante Digital AI",
  "version": "1.0",
  "description": "Protección forense proactiva con IA contra phishing, correos sospechosos y fraudes financieros.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"]
    }
  ]
}
